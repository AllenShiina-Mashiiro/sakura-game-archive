# Local PostgreSQL (Docker Compose)
POSTGRES_USER=sakura_admin
POSTGRES_DB=sakura_game_archive
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_VOLUME=sakura-game-archive
# For running Next.js directly on Windows; Compose overrides the hostname to postgres.
DATABASE_URL=postgresql://sakura_admin:replace-with-a-long-random-password@127.0.0.1:5432/sakura_game_archive
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000

# Initial administrator bootstrap
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# SMTP for six-digit email verification codes
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OAuth applications: register these callback URLs in each provider console.
# http://localhost:3000/api/auth/oauth/google
# http://localhost:3000/api/auth/oauth/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Temporary compatibility for existing Supabase Storage uploads only.
# Remove these after media files are migrated to local/object storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
