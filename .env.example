# Local PostgreSQL (Docker Compose)
POSTGRES_USER=sakura_admin
POSTGRES_DB=sakura_game_archive
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_VOLUME=sakura-game-archive
DATABASE_URL=postgresql://sakura_admin:replace-with-a-long-random-password@127.0.0.1:5432/sakura_game_archive
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000

# Used only to create the initial admin account when no admin exists.
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Temporary compatibility for existing Supabase Storage uploads/media.
# The core application database and login rate limiting now use local PostgreSQL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# SMTP for numeric email verification codes
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
