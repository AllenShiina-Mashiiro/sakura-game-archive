# Server-only secrets. Never prefix the service role key with NEXT_PUBLIC_.
SESSION_SECRET=replace-with-at-least-32-random-characters
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Used only to create the initial admin account when no admin exists; use 10+ characters.
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Required for login rate limiting.
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Keep false until the Database 2.0 Beta SQL migration has been run and verified.
DATABASE_V2_ENABLED=false
